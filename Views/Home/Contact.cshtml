@model Contact




<table class="table table-dark">
<thead>
<tr>
 
    <th>Name<th>
    <th>Phone</th>
    <th>City</th>
    <th>Governorate</th>
</tr>
</thead>
<tbody>
<tr>
    <td>@Model.Name</td>
    <td>@Model.Phone</td>
    <td>@Model.City</td>
    <td>@Model.Governorate</td>
</tr>
</tbody>
</table>