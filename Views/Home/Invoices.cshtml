@model IEnumerable<invoices.Models.Contact>

<h2>جهات الاتصال</h2>
@{
    int numberP = 1;
}
<table class="table table-striped">
    <thead>
    <tr>
        <th>Invoicenumber</th>
        <th>Company</th>
        <th>InvoiceDate</th>
        <th>Notes</th>
        <th>Phone</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var i in Model)
    {
        <tr>
            <td>@numberP</td>
            <td>@i.Name</td>
            <td>@i.Phone</td>
            <td>@i.City</td>
            
            <th> <a href="@Url.Action("Contact", "Home", new { id = i.Id })">View</a></th>
            
            @{
                numberP++;
            }

        </tr>
        
        
        @foreach (var c in i.Invoices)
        {
            <tr>
                <td>  @c.Amount</td> 
                <td>   @c.Company</td> 
                <td>  @c.InvoiceDate</td> 
                <td>  @c.Notes</td> 
            </tr>
          
          
    
   
        }
       
    }

</table>

<a asp-action="CreateInvoice" class="btn btn-success">Add Invoice</a>